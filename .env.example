# Copia este archivo como .env y completa. Cada valor puede ser la clave o la ruta a un archivo de texto que la contiene.
GEMINI_API_KEY=ruta/a/tu_clave_gemini.txt
# ELEVENLABS_API_KEY=ruta/a/tu_clave_elevenlabs.txt

# Voz: gemini (por defecto) o elevenlabs
TTS_PROVEEDOR=gemini
TTS_VOZ=Algenib
TTS_MODELO=gemini-3.8-flash-tts
# Modelo de lenguaje para el borrador del guion
LLM_MODELO=gemini-3.5-flash
